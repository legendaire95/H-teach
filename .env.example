# Copier ce fichier en .env puis remplir les valeurs propres à votre machine.
# Ne jamais mettre de vrai mot de passe dans .env.example.

# --- Base de données MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hteach
DB_USER=root
DB_PASSWORD=

# --- Application ---
APP_ENV=development
APP_PORT=8000
APP_URL=http://localhost:8000