{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo \"Pas de build : pages statiques + API PHP\"",
  "outputDirectory": "frontend",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "redirects": [{ "source": "/", "destination": "/pages/index.html", "permanent": false }],
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index.php" }]
}
